<rendererInfo>
	<name value = "VRPG2" />
	<resolution width = "1280" height = "720" />
	<sceneXML path = "veach-ajar-2" />	<!--simpleTest bearBox veach-ajar-dynamic  veach-ajar-2  veach-mis staircase_change staircase-dynamic dining-room veach-bidir yanYun ReSTIR_Test_Scene-->

	<renderer type = "VRPG2">  <!--LPV VRPG VXPG FzbPathGuiding NPMPathGuiding PathTracing PathTracing_KPCNNDenoising VolumetricFog StochasticLightcuts ReSTIR_GI Deferred  Mesh  NeuralTextureCompression ZhiHuCode-->
		<maxDepth value = "4" />
		<useNEE value = "false" />
		<spp value = "1" />
		<LPV>
			<cascades value = "3" />
			<!-- 1..4 层嵌套网格，随相机移动并按格对齐 -->
			<resolution value = "32" />
			<!-- 每层网格分辨率 N（N^3 个格子），必须是 8 的倍数 -->
			<rsmResolution value = "256" />
			<!-- 每盏灯虚拟 RSM 的分辨率，等于注入的 VPL 数量上限 -->
			<iterations value = "8" />
			<!-- 光传播迭代次数（论文 3.3：级联下 8 次）；0 = 只注入不传播，用来看注入本身 -->
			<cellSize value = "0" />
			<!-- 最细层的格子边长（米）；填 0 则按场景包围盒自动取值（约 场景直径 / N） -->
			<useOcclusion value = "true" />
			<useDampening value = "true" />
			<saveFrame value = "-1" />
			<!-- 在第 n 帧把 tonemap 后的结果存成 exe 目录下的 lpv_snapshot.png（-1 关闭） -->
			<!-- 其余量（半格偏移、5 个出口面、2/s 距离假设、级联两级插值）都由论文固定，不再暴露为参数 -->
		</LPV>

		<RasterVoxelization>
			<resolution value = "1024, 1024" />
			<voxelCount value="32" />
		</RasterVoxelization>
		<LightVGB>
			<resolution value = "256, 256" />
			<!-- Must be a power of two. 16 is cheaper; 32 gives the E-tree
			     the same spatial detail as the previous upsampled version. -->
			<voxelCount value="16" />
		</LightVGB>

		<VRPG>
			<GeometryInjection>
				<resolution value = "1024, 1024" />
				<voxelCount value="32" />
			</GeometryInjection>
			<GeometryClustering>
				<clusteringThreshold value="0.75" />
				<clusteringTopLayer value="3" />
			</GeometryClustering>
			<LightInjection>
				<sampleCountPerVoxel value = "32" />
				<bounces value="1" />
			</LightInjection>
			<LightClustering>
				<!-- 光树叶层复用几何体素层：不额外配置分辨率，深度取 geometryOctreeDepth -->
			</LightClustering>
			<RIS>
				<!-- 候选选择策略是编译期宏：src/renderer/VRPG2/RIS/RISShaderio.h
				     VRPG_Candidate_Samples_SampleMode = 1 (bounded pool light cut, M = 32)
				                                     = 0 (greedy relative error cut, M = 64) -->
			</RIS>
			<PathGuiding>
				<!-- 引导采样与 BSDF 采样的 MIS 由 VRPG_PATH_SAMPLE_MODE 控制（默认 1） -->
			</PathGuiding>
		</VRPG>

		<VXPG>
			<voxelResolution value = "64" />
			<!-- 8..128，2 的幂 -->
			<spixelSize value = "32" />
			<!-- 4..256；会自动放大以免网格过大 -->
			<bounce value = "3" />
			<!-- 首个间接顶点后的额外 BSDF+NEE 弹射 -->
			<misMode value = "1" />
			<!-- 0 = one-sample, 1 = balance, 2 = power -->
		</VXPG>
		<LightInject></LightInject>
		<Octree></Octree>
	</renderer>
	
</rendererInfo>